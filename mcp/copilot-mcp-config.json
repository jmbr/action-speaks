{
  "mcpServers": {
    "action-speaks": {
      "type": "local",
      "command": "python3",
      "args": ["-m", "action_speaks.mcp_server"],
      "cwd": "__ACTION_SPEAKS_ROOT__",
      "env": {
        "PYTHONPATH": "__ACTION_SPEAKS_ROOT__",
        "PYTHONUNBUFFERED": "1"
      },
      "tools": ["*"]
    }
  }
}
