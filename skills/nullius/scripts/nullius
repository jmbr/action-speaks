#!/usr/bin/env bash
# Thin wrapper around the nullius verifier, callable from any working directory.
#
#   nullius verify "informal claim" < proof.lean     check a proof (stdin or -f FILE)
#   nullius statement '(n : ℕ) (h : 5 < n) : 25 < n * n'
#   nullius search 'sum of two even numbers is even'
#   nullius close '25 < n * n' -b '(n : ℕ) (h : 5 < n)'
#   nullius log
#   nullius doctor
#
# `check` is accepted as an alias for `verify`. These names are also the MCP tool names, so
# the same workflow applies whether you are at a shell or driving this from an agent.
#
# Exit status for `verify` is 0 when verified, 1 otherwise, so it composes with && / ||.

set -uo pipefail

# Resolve this script's real path, following symlinks, so the verifier is found whether the
# skill runs from inside the repository or through a symlink in ~/.agents/skills.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(cd -P "$(dirname "$self")" && pwd)/$target" ;;
  esac
done
script_dir="$(cd -P "$(dirname "$self")" && pwd)"

# <repo>/skills/nullius/scripts/nullius  ->  <repo>
default_root="$(cd -P "$script_dir/../../.." && pwd)"
ROOT="${NULLIUS_ROOT:-$default_root}"

if [ ! -d "$ROOT/nullius" ]; then
  cat >&2 <<EOF
nullius verifier not found at: $ROOT

This skill expects to live inside the verifier repository (as skills/nullius), or to
be symlinked from it. Reinstall with the repository's install.sh, or set NULLIUS_ROOT to the
repository path.
EOF
  exit 2
fi

cmd="${1:-}"
[ $# -gt 0 ] && shift

run() { (cd "$ROOT" && PYTHONPATH="$ROOT" python3 -m nullius.cli "$@"); }

case "$cmd" in
  check|verify)
    claim=""
    file=""
    extra=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -f|--file) file="$2"; shift 2 ;;
        -*)        extra+=("$1"); shift ;;
        *)         if [ -z "$claim" ]; then claim="$1"; else extra+=("$1"); fi; shift ;;
      esac
    done

    if [ -n "$file" ]; then
      src_arg="$file"
    else
      # Read the proof from stdin into a temp file so the CLI can report line numbers.
      tmp="$(mktemp -t nullius-XXXXXX.lean)"
      trap 'rm -f "$tmp"' EXIT
      cat > "$tmp"
      if [ ! -s "$tmp" ]; then
        echo "no Lean source on stdin; pipe a proof or pass -f FILE" >&2
        exit 2
      fi
      src_arg="$tmp"
    fi

    if [ -n "$claim" ]; then
      run verify "$src_arg" -c "$claim" "${extra[@]+"${extra[@]}"}"
    else
      run verify "$src_arg" "${extra[@]+"${extra[@]}"}"
    fi
    ;;

  statement|search|close|log|doctor)
    run "$cmd" "$@"
    ;;

  ""|-h|--help|help)
    sed -n '3,13p' "$self" | sed 's/^# \{0,1\}//'
    ;;

  *)
    echo "unknown command: $cmd (try: verify, statement, search, close, log, doctor)" >&2
    exit 2
    ;;
esac
